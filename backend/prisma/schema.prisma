generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Used only by `prisma migrate`/`db push` — Neon's pooled connection (PgBouncer)
  // can't hold the advisory lock migrations need, so those commands need the direct one.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

enum InventoryTransactionType {
  ADDITION
  DEDUCTION
  ADJUSTMENT
  SALE
  REFUND
  TRANSFER_IN
  TRANSFER_OUT
}

enum StockTransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum SaleStatus {
  DRAFT
  PAID
  CANCELLED
  REFUNDED
}

enum SaleSource {
  POS
  MIKROTIK
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
  OTHER
}

// ---------- Organization ----------

model Organization {
  id        String   @id @default(cuid())
  name      String
  currency  String   @default("GHS")
  taxRate   Decimal  @default(0) @db.Decimal(5, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                  User[]
  stores                 Store[]
  products               Product[]
  categories             Category[]
  expenseCategories      ExpenseCategory[]
  voucherProfileMappings VoucherProfileMapping[]
}

// ---------- Users & Access ----------

model User {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CASHIER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  storeAccess          UserStore[]
  inventoryTransactions InventoryTransaction[]
  stockTransfersCreated StockTransfer[]
  sales                Sale[]
  expensesRecorded      Expense[]

  @@index([organizationId])
}

// Which stores a non-admin user (manager/cashier) may operate in
model UserStore {
  id      String @id @default(cuid())
  userId  String
  storeId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId])
}

// ---------- Stores ----------

model Store {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name      String
  address   String?
  phone     String?
  email     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Machine credential for the MikroTik integration (router-side script authenticates
  // webhook calls with this instead of a user login). Null until an admin generates one.
  mikrotikToken String? @unique

  userAccess            UserStore[]
  storeProducts         StoreProduct[]
  inventoryTransactions InventoryTransaction[]
  transfersOut          StockTransfer[] @relation("SourceStore")
  transfersIn           StockTransfer[] @relation("DestinationStore")
  customers             Customer[]
  sales                 Sale[]
  expenses              Expense[]
  voucherRedemptions    VoucherRedemption[]

  @@index([organizationId])
}

// ---------- Products & Categories ----------

model Category {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name      String
  createdAt DateTime @default(now())

  products Product[]

  @@unique([organizationId, name])
}

model Product {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  name           String
  sku            String?
  barcode        String?
  description    String?
  costPrice      Decimal  @default(0) @db.Decimal(12, 2)
  sellingPrice   Decimal  @default(0) @db.Decimal(12, 2)
  unit           String   @default("pcs")
  minStockLevel  Int      @default(0)
  imageUrl       String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  storeProducts         StoreProduct[]
  inventoryTransactions InventoryTransaction[]
  stockTransfers        StockTransfer[]
  saleItems             SaleItem[]
  voucherProfileMapping VoucherProfileMapping?
  voucherRedemptions    VoucherRedemption[]

  @@index([organizationId])
  @@index([categoryId])
  @@index([barcode])
}

// Per-store inventory quantity for a product
model StoreProduct {
  id        String   @id @default(cuid())
  storeId   String
  productId String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity  Int      @default(0)

  // Per-store price override. Null means "use the product's default price" —
  // only set these for stores that actually charge something different.
  costPrice    Decimal? @db.Decimal(12, 2)
  sellingPrice Decimal? @db.Decimal(12, 2)

  updatedAt DateTime @updatedAt

  @@unique([storeId, productId])
  @@index([productId])
}

model InventoryTransaction {
  id        String                   @id @default(cuid())
  storeId   String
  productId String
  userId    String
  store     Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product   Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User                     @relation(fields: [userId], references: [id])

  type             InventoryTransactionType
  quantity         Int
  previousQuantity Int
  newQuantity      Int
  reason           String?
  referenceId      String?
  createdAt        DateTime                 @default(now())

  @@index([storeId])
  @@index([productId])
  @@index([createdAt])
}

model StockTransfer {
  id                  String   @id @default(cuid())
  organizationId       String
  productId            String
  sourceStoreId        String
  destinationStoreId   String
  createdById          String

  product            Product  @relation(fields: [productId], references: [id])
  sourceStore        Store    @relation("SourceStore", fields: [sourceStoreId], references: [id])
  destinationStore   Store    @relation("DestinationStore", fields: [destinationStoreId], references: [id])
  createdBy          User     @relation(fields: [createdById], references: [id])

  quantity    Int
  status      StockTransferStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  completedAt DateTime?

  @@index([sourceStoreId])
  @@index([destinationStoreId])
  @@index([productId])
}

// ---------- Customers ----------

model Customer {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]

  @@index([storeId])
  @@index([phone])
}

// ---------- Sales ----------

model Sale {
  id         String   @id @default(cuid())
  storeId    String
  customerId String?
  userId     String

  store    Store     @relation(fields: [storeId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  cashier  User      @relation(fields: [userId], references: [id])

  receiptNumber String        @unique
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  status        SaleStatus    @default(DRAFT)
  source        SaleSource    @default(POS)

  refundedFromId String?
  refundedFrom   Sale?   @relation("SaleRefund", fields: [refundedFromId], references: [id])
  refunds        Sale[]  @relation("SaleRefund")

  emailSentAt DateTime?
  emailSentTo String?

  editedAt       DateTime?
  editedByUserId String?

  // When this sale transitioned DRAFT -> PAID. Refund/edit are only allowed within a
  // fixed window after this (see EDIT_REFUND_WINDOW_MS in sales.service.js) — old,
  // already-settled invoices shouldn't be mutable indefinitely.
  paidAt DateTime?

  // When this sale was refunded (status -> REFUNDED). Used by the Accounts Sheet report
  // to date the "loss" row on the day the refund actually happened, not whenever the
  // row happens to be generated.
  refundedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items              SaleItem[]
  payments           Payment[]
  voucherRedemptions VoucherRedemption[]

  @@index([storeId])
  @@index([customerId])
  @@index([userId])
  @@index([createdAt])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id     String @id @default(cuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String?
  createdAt DateTime      @default(now())

  @@index([saleId])
}

// ---------- Expenses ----------

model ExpenseCategory {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name      String
  createdAt DateTime @default(now())

  expenses Expense[]

  @@unique([organizationId, name])
}

model Expense {
  id         String @id @default(cuid())
  storeId    String
  categoryId String
  recordedById String

  store        Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category     ExpenseCategory @relation(fields: [categoryId], references: [id])
  recordedBy   User            @relation(fields: [recordedById], references: [id])

  description   String
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  date          DateTime
  attachmentUrl String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([storeId])
  @@index([categoryId])
  @@index([date])
}

// ---------- MikroTik voucher integration ----------

// Maps a MikroTik hotspot user-profile name (e.g. "1-Day", "1-Week") to a Product, so
// incoming webhook events know which inventory item a voucher batch/redemption refers to.
model VoucherProfileMapping {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String       @unique
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  profileName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([organizationId, profileName])
}

// One row per voucher redemption (a customer logging in with a voucher code), reported by
// the router in real time. Stock is deducted immediately when this is created; `saleId` is
// filled in later by the nightly close-out job once it's rolled into a daily Sale, so a
// redemption is never counted into revenue twice.
model VoucherRedemption {
  id        String  @id @default(cuid())
  storeId   String
  productId String
  saleId    String?

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale    Sale?   @relation(fields: [saleId], references: [id])

  profile     String
  voucherCode String?
  redeemedAt  DateTime @default(now())

  // Postgres treats NULL as distinct in unique constraints, so this only dedupes real
  // voucher codes from the router — manual redemptions (voucherCode: null) are unaffected.
  @@unique([storeId, voucherCode])
  @@index([storeId, productId, saleId])
  @@index([redeemedAt])
}
