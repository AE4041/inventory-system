# Postgres connection string used by the running app.
# Local docker-compose default:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventory?schema=public"

# Only needed with a pooled provider (e.g. Neon's "-pooler" URL above). Prisma's
# migrate/db-push commands need a direct (non-pooled) connection to take an advisory
# lock, which PgBouncer-style poolers don't support. On Neon, copy the "Direct
# connection" string from the same dashboard page (same DB, no "-pooler" in the host).
# With plain Docker Postgres (no pooler involved) this can just repeat DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventory?schema=public"

# JWT
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# Server
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Email (Resend) - https://resend.com
RESEND_API_KEY=""
RECEIPT_FROM_EMAIL="receipts@yourdomain.com"

# MikroTik voucher integration
# Cron schedule (5-field) for the nightly in-process close-out job. Server-local time.
VOUCHER_CLOSEOUT_CRON="5 0 * * *"
# Shared secret for the external-scheduler-friendly POST /api/integrations/mikrotik/close-day-all
# endpoint (only needed if you're deploying serverless and using something like Vercel Cron
# instead of the in-process job). Leave blank to disable that endpoint entirely.
CRON_SECRET=""
